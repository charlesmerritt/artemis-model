# Python
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
.coverage
htmlcov/

# Jupyter
.jupyter-runtime/

# Data — inputs and outputs are not committed; versions.lock documents what to acquire
data/raw
data/interim/
data/processed/
data/build/
# Local copies pulled from R2 by pipeline/data_access.py
data/r2_cache/

# GEE credentials
.config/earthengine/

# FVS binaries and build artifacts
fvs/bin/
fvs/build/
*.db          # SQLite FVS runs (large); keep fvs_input.db path in versions.lock
*.log

# Jupyter
.ipynb_checkpoints/
notebooks/**/.ipynb_checkpoints/
notebooks/Mgmt-Units-Pilot_5co_FL.ipynb

# Rust (future)
target/
Cargo.lock    # exception: re-add if this becomes a binary crate

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Git worktrees
worktrees/
.worktrees/
# Agents — local agent state stays untracked, but the shared session-start hook
# and its settings must be committed or Claude Code on the web cannot run it.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/environment-setup.sh
worktrees/

# External Scripts — this directory is a drop zone for one-off local scripts, so
# it is ignored wholesale and the few tracked, shared ones are named back in.
# check-staged-large-files.sh was already tracked despite matching `scripts/*`:
# git keeps honouring a file it is already tracking, so the omission was
# invisible until someone re-added it from a fresh clone. Named explicitly now.
scripts/*
!scripts/check-staged-large-files.sh
!scripts/merge-uv-lock.sh

# Environment bootstrap. setup-env.sh is the README quickstart's first command, so
# a fresh clone that silently dropped it would break the documented setup path.
!scripts/setup-env.sh
!scripts/claude-code-env-setup.sh
!scripts/r2_index.py

# The LETO ArcGIS prototype: the workflow ARTEMIS is a reimplementation of, kept
# as reference text rather than runnable code (it is arcpy, and there is no
# ArcGIS here). Tracked because pipeline modules cite these paths in their
# docstrings — assign_plt_cn.py and sliver_merge.py both point at LETO.V1.1.txt
# for the procedure they reimplement, and those citations should resolve.
!scripts/LETO.V1.1.txt
!scripts/LETO_CSV_PIPELINE.txt
!scripts/Create_FVS_Database.txt
!scripts/Join_FVS_output_to_arc.txt
!scripts/README.txt
