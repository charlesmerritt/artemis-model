#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
"$repo_root/scripts/check-staged-large-files.sh"

# The repository's rules and documentation are executable; run them before a commit
# records a state that breaks them. Bypass once with `git commit --no-verify`.
cd "$repo_root"
uv run --quiet python scripts/check_conventions.py
uv run --quiet python scripts/check_docs.py
