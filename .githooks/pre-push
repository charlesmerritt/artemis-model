#!/usr/bin/env bash
set -euo pipefail

# Refuse to push a uv.lock that does not match pyproject.toml.
#
# This exists because of a specific failure, not a hypothetical one. During the
# 2026-08-10 merge train, .githooks/post-merge correctly re-resolved uv.lock
# after a merge but — being advisory — left the result unstaged. Every local
# check then passed, because `uv sync --locked` and `uv lock --check` read the
# *working tree*, where the regeneration was sitting. The *committed* lockfile
# was still HEAD's, and that is what got pushed. CI failed on the very first
# step, in a state that no local command had disagreed with.
#
# That gap — working tree green, committed tree red — is invisible to every
# check that runs before it. The push is the last moment it can be caught, so
# it is caught here.
#
# Set ARTEMIS_SKIP_LOCK_CHECK=1 to bypass (e.g. pushing a deliberate WIP).

[ "${ARTEMIS_SKIP_LOCK_CHECK:-0}" = "1" ] && exit 0

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

fail() {
  printf 'pre-push: %s\n' "$1" >&2
  printf 'pre-push: fix with:  uv lock && git add uv.lock && git commit\n' >&2
  printf 'pre-push: bypass with:  ARTEMIS_SKIP_LOCK_CHECK=1 git push\n' >&2
  exit 1
}

# The exact shape of the bug: a lockfile fix that exists on disk but not in any
# commit. Checked first because it has the most specific, most actionable
# message, and because `uv lock --check` below would report the working tree as
# perfectly fine while the push carried something else entirely.
if ! git diff --quiet HEAD -- uv.lock; then
  fail "uv.lock has uncommitted changes — the committed lockfile is not what you just verified"
fi

command -v uv >/dev/null 2>&1 || exit 0

# Catches staleness from any other cause: a hand-edited pyproject.toml, a
# rebase that dropped the lock update, a cherry-pick that took one and not the
# other. Working tree and HEAD agree by this point, so checking either is
# checking both.
#
# Network-dependent, and a push should not fail because someone is on a train.
# Distinguish "uv says the lockfile is stale" from "uv could not tell": only the
# first is a real answer, and only the first blocks.
if check_output="$(uv lock --check 2>&1)"; then
  exit 0
fi

if printf '%s' "$check_output" | grep -q 'needs to be updated'; then
  fail "uv.lock is out of sync with pyproject.toml"
fi

printf 'pre-push: could not verify uv.lock (offline?); pushing anyway\n' >&2
exit 0
